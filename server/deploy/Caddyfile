{$MARKET_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 7MB
    }
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    handle_path /media/* {
        root * /srv/media
        header Content-Security-Policy "default-src 'none'; sandbox"
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
}
