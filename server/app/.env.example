# Copy to app/.env on a PRIVATE server. Never commit populated secrets.
DEBUG=0
TESTING=0
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=marketplace.example.invalid
SITE_URL=https://marketplace.example.invalid
SITE_NAME=Zadenvo
DATABASE_URL=postgresql://marketplace:CHANGE_ME@db:5432/marketplace
MEDIA_ROOT=/data/media
TRUST_PROXY=1
REGISTRATION_OPEN=0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=
# disabled -> test -> live only after verified provider approval and acceptance.
PAYMENTS_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
PROVIDER_APPROVED=0
PRIVATE_SELLERS_APPROVED=0
LIVE_APPROVED=0
PAYOUT_HOLD_DAYS=7
