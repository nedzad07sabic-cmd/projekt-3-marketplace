# Template only; activate separately after workflow permission/cost review.
name: Marketplace server tests
'on': [push, pull_request]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    defaults:
      run:
        working-directory: server/app
    services:
      postgres:
        image: postgres:17
        env:
          POSTGRES_DB: marketplace
          POSTGRES_USER: marketplace
          POSTGRES_PASSWORD: isolated-ci-only
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U marketplace -d marketplace"
          --health-interval 10s --health-timeout 5s --health-retries 10
    env:
      TESTING: '1'
      DEBUG: '0'
      PAYMENTS_MODE: disabled
      DATABASE_URL: postgresql://marketplace:isolated-ci-only@127.0.0.1:5432/marketplace
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
      - run: pip install -r requirements.txt
      - run: python manage.py migrate --noinput
      - run: python manage.py makemigrations --check --dry-run
      - run: python -m unittest discover -s ../tools/tests -v
      - run: python manage.py test market.tests --verbosity 2
